{
  "schema_version": "0.1",
  "run_id": "dqn-small-reference-v0.1",
  "verification_status": "UNVERIFIED_REFERENCE_CONFIG",
  "execution_status": "The current aal train command does not consume config files; these values document an implementation-aligned reference run.",
  "agent": {
    "id": "dqn",
    "implementation": "DQNAgent",
    "observation_encoder": {
      "id": "flat_grid_orders_v1",
      "vector_size_formula": "4 * width * height + 3 + 12 * max_orders",
      "grid_channels": [
        "permanent_obstacles",
        "charging_stations",
        "dynamic_blockages",
        "robot_position"
      ],
      "global_features": [
        "normalized_time",
        "normalized_battery",
        "carrying_flag"
      ],
      "per_order_features": [
        "normalized_pickup_x",
        "normalized_pickup_y",
        "normalized_dropoff_x",
        "normalized_dropoff_y",
        "normalized_release_time",
        "normalized_deadline",
        "normalized_priority",
        "pending_status_bit",
        "available_status_bit",
        "picked_up_status_bit",
        "delivered_status_bit",
        "expired_status_bit"
      ],
      "padding": "zero_fill_unused_order_slots_up_to_max_orders",
