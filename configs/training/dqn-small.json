      "output_activation": "linear",
      "initialization": "he_normal_hidden_and_xavier_like_normal_output",
      "loss": "selected_action_mean_squared_td_error",
      "optimizer": "plain_sgd",
      "bootstrap": "masked_max_from_target_network",
      "double_dqn": false,
      "target_update": "hard_copy_after_target_sync_interval_optimizer_updates"
    },
    "hyperparameters": {
      "hidden_sizes": [
        64,
        64
      ],
      "gamma": 0.99,
      "learning_rate": 0.001,
      "batch_size": 32,
      "replay_capacity": 10000,
      "warmup_steps": 200,
      "update_every": 1,
      "target_sync_interval": 200,
      "epsilon_start": 1.0,
      "epsilon_end": 0.05,
      "epsilon_decay_steps": 5000,
      "max_grad_norm": 10.0
    }
  },
  "training": {
    "scenario": "scenarios/small/dynamic-demo.json",
    "episodes": 1000,
    "root_seed": 2026080501,
